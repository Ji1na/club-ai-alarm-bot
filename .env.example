# ── Discord ──────────────────────────────────────────────
# Discord Developer Portal에서 발급
# https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# 순위 자동 공지할 채널 ID (채널 우클릭 → ID 복사)
ANNOUNCE_CHANNEL_ID=your_channel_id_here

# ── OpenAI ───────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── 봇 설정 ──────────────────────────────────────────────
# 지각 기준: 세션 시작 후 몇 분부터 지각 처리 (기본 10분)
LATE_THRESHOLD_MIN=10

# 조기 공지 기준: 지각 몇 회부터 30분 일찍 공지 (기본 3회)
EARLY_NOTIFY_COUNT=3

# DB 파일 경로 (기본: alimi.db)
DB_PATH=alimi.db
